+#[test]
+fn diagnostic_delayed_script_completion_over_tcp() {
+    let server = server();
+    server.set_drop_udp(true);
+    let started = Instant::now();
+    let (first, outcome, out) = run_script(server.addr(), Action::Named("late-script".into()), "sleep 3; echo LATE-$((6*7))\n");
+    let returned = Instant::now();
+    let text = String::from_utf8_lossy(&out);
+    let delivered = text.contains("LATE-42");
+    eprintln!("DIAG delayed elapsed={:?} outcome={outcome:?} delivered={delivered} bytes={}", started.elapsed(), out.len());
+    let stop = returned + Duration::from_secs(5);
+    let mut late = false;
+    while Instant::now() < stop {
+        let screen = server.session_screen(first.session).unwrap_or_default().join("\n");
+        if screen.contains("LATE-42") { late = true; eprintln!("DIAG delayed late_output_after={:?}", returned.elapsed()); break; }
+        thread::sleep(Duration::from_millis(20));
+    }
+    eprintln!("DIAG delayed late={late} output={text:?}");
+    assert!(delivered || late, "server eventually executes the input command");
+}
