+        }
+    }
+
+    #[test]
+    fn tcp_probe60_preserves_existing_high_utilization_growth() {
+        for tcp in [false, true] {
+            assert_eq!(tcp_probe60_fixture(tcp, 8100, false, 100).capacity, Some(125_000.0));
+        }
