+    fn transit_floor_includes_twenty_and_retains_far_measured_bdp() {
+        let now = Instant::now();
+        for (floor, expected) in [(20.0, 640), (300.0, 9_600)] {
+            let mut tx = Sender::new(0);
+            tx.floor_rtt = Some(floor);
